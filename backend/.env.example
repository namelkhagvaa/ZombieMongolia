# backend/.env болгон хуулж бөглөнө. Энэ файлыг (.env) git-д ОРУУЛАХГҮЙ.
# Доорх утгууд бодит сервер (https://zombie-api.apps.mn) дээрх тохиргоо.

DEBUG=0
# Урт санамсаргүй мөр: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=zombie-api.apps.mn
CSRF_TRUSTED_ORIGINS=https://zombie-api.apps.mn
# Хөтөч дээрх тоглоом (play-zombie.apps.mn) API руу хандах эрх
CORS_ALLOWED_ORIGINS=https://play-zombie.apps.mn

# Өгөгдлийн сан: mysql (серверт), sqlite (зөвхөн өөрийн компьютерт)
DB_ENGINE=mysql
DB_NAME=zombie
DB_USER=zombie
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# QPay: production (бодит төлбөр). mock нь зөвхөн автомат тестэд (DEBUG=0 үед ажиллахгүй)
QPAY_MODE=production
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# QPay төлбөр орсныг мэдэгдэх хаяг: <PUBLIC_BASE_URL>/api/qpay/callback/...
PUBLIC_BASE_URL=https://zombie-api.apps.mn

# Нээлттэй өрөө: relay сервертэй (server/relay.js, RELAY_SECRET) ижил урт санамсаргүй мөр
RELAY_SECRET=

# Утас баталгаажуулалт: verifymn (тоглогч өөрийн утаснаас 144773 руу код илгээнэ).
# console нь зөвхөн автомат тестэд (DEBUG=0 үед ажиллахгүй)
SMS_MODE=verifymn
VERIFYMN_API_URL=https://api.verify.mn
VERIFYMN_API_KEY=

